# River Server - Environment Variables Example
# Copy this file to .env and update with your values

# ==================== OpenAI API ====================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ==================== Yating API ====================
YATING_API_KEY=your_yating_api_key_here
YATING_TTS_ENDPOINT=https://tts.api.yating.tw

# ==================== MQTT Configuration ====================
MQTT_HOST=test.mosquitto.org
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=river-server
MQTT_TOPIC_PREFIX=river/wheel

# ==================== ASR Parameters ====================
# Maximum wait time for ASR (seconds)
ASR_MAX_WAIT=12.0
# Time gap for early stop when no new partial results (seconds)
ASR_STABILITY_GAP=0.5
# Wait time for first callback (seconds)
ASR_FIRST_CB_WAIT=2.0
# Grace period before timeout (seconds)
ASR_GRACE_TAIL=0.8

# ==================== TTS Parameters ====================
# Timeout for TTS API calls (seconds)
YATING_TTS_TIMEOUT=12
